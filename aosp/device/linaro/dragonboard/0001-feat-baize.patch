diff --git a/db845c.mk b/db845c.mk
index 6a82598..099aa73 100644
--- a/db845c.mk
+++ b/db845c.mk
@@ -1,5 +1,5 @@
 # Target defaults to 64- and 32-bit
-TARGET_64BIT_ONLY ?= false
+TARGET_64BIT_ONLY ?= true
 
 # Target can boot 16K kernels - defaults to false
 # If BOOTS_16K is set, enable 64BIT_ONLY as well
@@ -9,6 +9,13 @@ ifeq ($(TARGET_BOOTS_16K), true)
   TARGET_64BIT_ONLY := true
 endif
 
+PRODUCT_COMPRESSED_APEX := false
+#PRODUCT_VENDOR_PROPERTIES += pm.dexopt.first-boot=skip
+PRODUCT_VENDOR_PROPERTIES += persist.sys.device_provisioned=1
+PRODUCT_VENDOR_PROPERTIES += ro.setupwizard.mode=DISABLED
+# izaac: add boot animation
+PRODUCT_COPY_FILES += device/linaro/dragonboard/bootanimation.zip:$(TARGET_COPY_OUT_SYSTEM)/media/bootanimation.zip
+
 $(call inherit-product, device/linaro/dragonboard/full.mk)
 ifeq ($(TARGET_64BIT_ONLY), true)
   $(call inherit-product, $(SRC_TARGET_DIR)/product/core_64_bit_only.mk)
@@ -17,8 +24,10 @@ else
 endif
 $(call inherit-product, $(SRC_TARGET_DIR)/product/full_base.mk)
 $(call inherit-product, device/linaro/dragonboard/shared/graphics/drm_hwcomposer/device.mk)
-$(call inherit-product, device/linaro/dragonboard/shared/graphics/mesa/device.mk)
-$(call inherit-product, device/linaro/dragonboard/shared/graphics/minigbm_msm/device.mk)
+# izaac: use swangle but mesa because android 15 need gpu cap id set 6, not 1 & 2
+$(call inherit-product, device/linaro/dragonboard/shared/graphics/swangle/device.mk)
+#$(call inherit-product, device/linaro/dragonboard/shared/graphics/mesa/device.mk)
+#$(call inherit-product, device/linaro/dragonboard/shared/graphics/minigbm_msm/device.mk)
 $(call inherit-product, device/linaro/dragonboard/db845c/device.mk)
 
 #Boot with Android boot image header v3
